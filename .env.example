# Frontend Config (Vite + Google OAuth)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
# Leave VITE_API_BASE_URL blank on Vercel (uses same-origin /api serverless routes)
# Set to http://localhost:3001 only if running backend on a separate port without Vite proxy
VITE_API_BASE_URL=

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Google OAuth Verification (must match VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Database Configuration (Turso Free Tier LibSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Signing Secret (REQUIRED in production - min 32 random chars)
JWT_SECRET=replace-with-strong-64-char-random-secret
